# ── Web (Vercel) ──────────────────────────────────────────────────────────────
# Supabase project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=

# URL of the Render worker service
WORKER_URL=

# Shared secret between Next.js API and the worker (min 32 chars)
WORKER_SHARED_SECRET=

# ── Worker (Render) ───────────────────────────────────────────────────────────
# Same Supabase URL as above (needed server-side in the worker)
SUPABASE_URL=

# Service-role key for the worker (same value as above)
# SUPABASE_SERVICE_ROLE_KEY= (already listed)

# Google Gemini API key
GEMINI_API_KEY=

# Gemini model id to use (e.g. gemini-3.5-flash — check AI Studio for free-tier ids)
AI_MODEL=

# Set to "1" in test runs to force AI analysis to return an incomplete result
AI_FORCE_FAIL=
